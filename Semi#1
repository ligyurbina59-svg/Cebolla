# ============================================================
# PostgreSQL - Termux / LAN + TLS + SCRAM
# ============================================================

# ------------------------------------------------------------
# CONEXIONES
# ------------------------------------------------------------

listen_addresses = '*'
port = 5432

max_connections = 50


# ------------------------------------------------------------
# AUTENTICACIÓN / SEGURIDAD
# ------------------------------------------------------------

password_encryption = scram-sha-256


# ------------------------------------------------------------
# TLS / SSL
# ------------------------------------------------------------

ssl = on

ssl_cert_file = 'certs/server.crt'
ssl_key_file = 'certs/server.key'

# TLS mínimo recomendado
ssl_min_protocol_version = 'TLSv1.2'

# No permitir renegociación insegura
ssl_prefer_server_ciphers = on


# ------------------------------------------------------------
# MEMORIA — VALORES MODERADOS PARA TERMUX
# ------------------------------------------------------------

shared_buffers = 128MB

work_mem = 4MB

maintenance_work_mem = 64MB

effective_cache_size = 512MB


# ------------------------------------------------------------
# WAL
# ------------------------------------------------------------

wal_level = replica

max_wal_size = 1GB

min_wal_size = 80MB


# ------------------------------------------------------------
# LOG
# ------------------------------------------------------------

logging_collector = on

log_destination = 'stderr'

log_line_prefix = '%m [%p] %u@%d '

log_connections = on

log_disconnections = on


# ------------------------------------------------------------
# LOCALIZACIÓN
# ------------------------------------------------------------

datestyle = 'iso, mdy'

timezone = 'UTC'services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: holoos
      POSTGRES_PASSWORD: tu_password
      POSTGRES_DB: holoos_db
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped

  api:
    build: ./api          # tu backend Node/Python
    environment:
      DATABASE_URL: postgres://holoos:tu_password@db:5432/holoos_db
    depends_on:
      - db
    restart: unless-stopped

  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./web:/usr/share/nginx/html:ro   # PWA estática (opcional)
    depends_on:
      - api
    restart: unless-stopped

volumes:
  pgdata:INTERNET
